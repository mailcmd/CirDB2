import Config

config :cir_db, config: [
  dir: "/tmp/cir_db",
  cache_dir: "/dev/shm/cir_db_chache",
  time_offset: -10800,
  id_length: 10,
  dir_index_depth: 4,
  sync_every: 300,            # seconds
  purge_every: 86400,         # seconds
  purge_older_than: 90*86400, # seconds
  rrdtool_binary: "/usr/bin/rrdtool"
]
